<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs and FindSecBugs exclusions. Every entry needs a comment with the reason
  and must be reviewed in the PR (AGENTS.md section 7). Keep this list short.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

  <!-- Spring injects collaborators and records expose immutable references by design;
       the EI_EXPOSE_REP family produces noise on constructor-injected beans. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!-- Value objects and exceptions validate their arguments in the constructor on purpose
       (architecture rule: records validate in the compact constructor). No class relies on
       finalizers, so the finalizer attack described by CT_CONSTRUCTOR_THROW does not apply. -->
  <Match>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- Business exceptions are never Java-serialized (they become JSON error bodies), so their
       transient details do not need to survive deserialization. -->
  <Match>
    <Class name="co.caudal.shared.error.DomainException"/>
    <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
  </Match>

  <!-- X-Request-Id is client controlled on purpose; it is only kept when it matches
       FieldLimits.REQUEST_ID_PATTERN, otherwise a new UUID replaces it. -->
  <Match>
    <Class name="co.caudal.api.filter.RequestIdFilter"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>

  <!-- NormalizedPassword is the one place that applies Unicode NFKC to a password; the detector
       warns about the normalization call itself, which is exactly the control. -->
  <Match>
    <Class name="co.caudal.domain.user.NormalizedPassword"/>
    <Bug pattern="IMPROPER_UNICODE"/>
  </Match>

  <!-- The refresh guard reads X-Requested-With and Origin to REJECT requests that do not match
       exact expected values; the header is never trusted as input data. -->
  <Match>
    <Class name="co.caudal.api.security.RefreshRequestGuard"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>

  <!-- The filter reads the Authorization header only to measure it and reject it if it is too
       large; the value is never used as data. -->
  <Match>
    <Class name="co.caudal.infrastructure.security.AuthorizationHeaderSizeFilter"/>
    <Bug pattern="SERVLET_HEADER"/>
  </Match>

  <!-- handleSecurity rethrows security exceptions on purpose, so that the Spring Security filters
       answer 401 or 403 in the canonical format and record the event. -->
  <Match>
    <Class name="co.caudal.api.error.ApiExceptionHandler"/>
    <Method name="handleSecurity"/>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
  </Match>

  <!-- HttpSecurity.build() declares throws Exception; the bean method cannot narrow it. -->
  <Match>
    <Class name="co.caudal.infrastructure.security.SecurityConfig"/>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>

  <!-- The body is application/json built from a fixed catalog message and the request id, which
       RequestIdFilter only accepts when it matches [A-Za-z0-9-]{1,40}; it is never rendered as
       HTML. -->
  <Match>
    <Class name="co.caudal.infrastructure.security.SecurityErrorWriter"/>
    <Bug pattern="XSS_SERVLET"/>
  </Match>

  <!-- Informational: controllers are endpoints by definition. Every route is denied by default by
       the security filter chain, and PermissionDeniedIT checks it. -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>

  <!-- The user agent is only stored (trimmed to 200 characters) as informational data of a session;
       no decision depends on it. -->
  <Match>
    <Class name="co.caudal.api.controller.AuthController"/>
    <Bug pattern="SERVLET_HEADER_USER_AGENT"/>
  </Match>
</FindBugsFilter>
