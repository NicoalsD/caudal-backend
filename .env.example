# =============================================================================
# CAUDAL, backend: variables de entorno de ejemplo
# =============================================================================
# Cómo usar este archivo:
#   1. Copiar a .env (cp .env.example .env). El archivo .env nunca se sube a git.
#   2. Reemplazar cada valor que empiece con "cambia-esto-" por un valor real.
#   3. Generar secretos con:  openssl rand -base64 32
#      (32 bytes en base64, aproximadamente 256 bits, sirven para la mayoría).
#   4. Nunca escribir valores reales en este archivo ni en el repositorio.
#
# Los valores sin marcador son valores por defecto de la especificación.
# Los marcados "verificar" son valores provisionales a confirmar.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL 18, Neon en la nube, Docker Compose en local)
# -----------------------------------------------------------------------------
# URL JDBC de la aplicación. El usuario de la aplicación es caudal_app (DML mínimo).
# En la nube usar sslmode=verify-full. En local, ver docs de despliegue.
DATABASE_URL=jdbc:postgresql://cambia-esto-host:5432/caudal?sslmode=verify-full
DATABASE_USERNAME=caudal_app
DATABASE_PASSWORD=cambia-esto-password-caudal-app

# Migraciones con Flyway. Usuario dueño del esquema (caudal_migrator).
# Usar siempre la conexión directa de Neon, no el pooler (verificar).
FLYWAY_URL=jdbc:postgresql://cambia-esto-host-directo:5432/caudal?sslmode=verify-full
FLYWAY_USER=caudal_migrator
FLYWAY_PASSWORD=cambia-esto-password-caudal-migrator

# -----------------------------------------------------------------------------
# Tokens de acceso (JWT HS256)
# -----------------------------------------------------------------------------
# Secreto de firma. Mínimo 256 bits (32 bytes). Rotarlo cierra todas las sesiones.
JWT_SECRET=cambia-esto-jwt-secret-openssl-rand-base64-32
# Emisor y audiencia. Se validan en cada token.
JWT_ISSUER=cambia-esto-issuer-caudal-api
JWT_AUDIENCE=cambia-esto-audience-caudal-web
# Duración del access token en minutos (especificación: 15).
JWT_ACCESS_TTL_MINUTES=15

# Duración del refresh token en días. Fontanero (OPERATOR) tiene su propio valor.
REFRESH_TTL_DAYS_DEFAULT=7
REFRESH_TTL_DAYS_OPERATOR=30

# -----------------------------------------------------------------------------
# Cookie de refresh y CORS
# -----------------------------------------------------------------------------
# None: la PWA (Vercel) y la API (Render) son sitios distintos. Con None se exige la
# cabecera X-Requested-With y la verificación de Origin. Strict solo si algún día
# comparten dominio.
COOKIE_SAME_SITE=None
# true en producción (HTTPS). En local, verificar con el navegador usado.
COOKIE_SECURE=true
# Lista separada por comas. Nunca "*" con credenciales.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://cambia-esto-dominio-pwa.vercel.app

# -----------------------------------------------------------------------------
# Contraseñas (Argon2id)
# -----------------------------------------------------------------------------
# Parámetros de la especificación. Al cambiarlos, el hash se recalcula al iniciar sesión.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
# Cuántas contraseñas anteriores se recuerdan para impedir su reutilización.
PASSWORD_HISTORY_SIZE=5

# -----------------------------------------------------------------------------
# Bloqueo de cuenta por intentos fallidos
# -----------------------------------------------------------------------------
# 5 fallos en la ventana de LOGIN_LOCK_MINUTES bloquean la cuenta.
# El bloqueo se duplica en cada reincidencia, hasta 24 horas.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Límite por IP, distinto del bloqueo por cuenta: 20 intentos en 15 minutos.
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_IP_WINDOW_MINUTES=15

# -----------------------------------------------------------------------------
# Límites de tasa (Bucket4j, almacenamiento en PostgreSQL)
# -----------------------------------------------------------------------------
# Login: 5 por minuto y por IP.
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Reportes públicos de daño: 3 por hora y por IP.
RATE_LIMIT_PUBLIC_REPORTS_PER_HOUR=3
# API general: 120 por minuto y por usuario.
RATE_LIMIT_API_PER_MINUTE=120
# Telemetría de dispositivos: 60 por minuto y por dispositivo.
RATE_LIMIT_TELEMETRY_PER_MINUTE=60
# Recálculo de pronóstico: 10 por hora y por acueducto.
RATE_LIMIT_FORECAST_PER_HOUR=10

# -----------------------------------------------------------------------------
# Servicio de pronóstico (caudal-ia)
# -----------------------------------------------------------------------------
# URL base del servicio de la IA, sin barra final.
IA_SERVICE_URL=http://localhost:8000
# Token de servicio: al menos 32 bytes aleatorios. Se envía como Bearer.
IA_SERVICE_TOKEN=cambia-esto-ia-service-token-openssl-rand-base64-32
# Token anterior, solo durante una rotación: la IA acepta ambos. Vacío fuera de la rotación.
IA_SERVICE_TOKEN_PREVIOUS=
# Tiempos de espera de la llamada a la IA, en milisegundos.
IA_CONNECT_TIMEOUT_MS=2000
IA_READ_TIMEOUT_MS=10000

# Circuit breaker de la IA (valores iniciales configurables).
# Tras estos fallos seguidos el circuito se abre y se usa la estimación simple.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Segundos que el circuito permanece abierto antes de probar de nuevo.
CIRCUIT_BREAKER_OPEN_SECONDS=60
# Llamadas de prueba permitidas en estado semiabierto.
CIRCUIT_BREAKER_HALF_OPEN_CALLS=2

# -----------------------------------------------------------------------------
# Formulario público (reportes de daño)
# -----------------------------------------------------------------------------
# Tiempo mínimo, en segundos, entre abrir el formulario y enviarlo. El campo
# honeypot "website" debe llegar vacío (no es variable de entorno).
PUBLIC_FORM_MIN_SECONDS=3

# -----------------------------------------------------------------------------
# Caché de permisos
# -----------------------------------------------------------------------------
# Tiempo de vida, en segundos, de los permisos cargados desde la BD.
PERMISSION_CACHE_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Documentación de la API (springdoc)
# -----------------------------------------------------------------------------
# true: Swagger UI y /v3/api-docs disponibles. false: ambas rutas responden 404.
API_DOCS_ENABLED=true

# -----------------------------------------------------------------------------
# Privacidad y criptografía
# -----------------------------------------------------------------------------
# Clave HMAC para guardar la IP de forma no reversible (en lugar de la IP en claro).
IP_HMAC_KEY=cambia-esto-ip-hmac-key-openssl-rand-base64-32

# Clave AES-256-GCM para el secreto TOTP (MFA). Exactamente 32 bytes en base64.
MFA_ENCRYPTION_KEY=cambia-esto-mfa-key-openssl-rand-base64-32
# Identificador de la clave, para rotarla sin perder los secretos cifrados anteriores.
MFA_KEY_ID=cambia-esto-id-llave-mfa-v1

# -----------------------------------------------------------------------------
# Dispositivos (firma Ed25519)
# -----------------------------------------------------------------------------
# Ventana de tolerancia del timestamp de la firma, en segundos (±300 s).
DEVICE_SIGNATURE_WINDOW_SECONDS=300
# Tiempo que se recuerda un nonce para impedir repeticiones, en segundos (10 min).
DEVICE_NONCE_TTL_SECONDS=600
# Días que la clave anterior sigue válida después de registrar una nueva.
DEVICE_KEY_ROTATION_DAYS=7

# -----------------------------------------------------------------------------
# Entradas
# -----------------------------------------------------------------------------
# Tamaño máximo del cuerpo JSON de una petición normal, en bytes (64 KiB).
# La telemetría y la importación tienen sus propios límites en el código.
MAX_JSON_BODY_BYTES=65536

# -----------------------------------------------------------------------------
# Operación
# -----------------------------------------------------------------------------
# Puerto HTTP. Render lo inyecta; en local, 8080.
PORT=8080

# Nivel de log de la aplicación: ERROR, WARN, INFO o DEBUG. Producción: INFO.
LOG_LEVEL=INFO
# true: carga el acueducto demo con datos simulados (is_demo = true). Verificar uso en producción.
SEED_DEMO_DATA=true
