<mxfile host="drawio"><diagram id="p0" name="flujo-caudal"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt1" value="Cómo funciona CAUDAL en 10 pasos" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="s2" value="1. La Junta pone las reglas&lt;br&gt;(versiones nuevas)" style="image;html=1;aspect=fixed;image=https://app.diagrams.net/img/lib/mscae/Person.svg;verticalLabelPosition=bottom;verticalAlign=top;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="90" width="50" height="56" as="geometry"/></mxCell><mxCell id="s3" value="2. El fontanero anota&lt;br&gt;la lectura (sin señal también)" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.mobile;pointerEvents=1;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="50" height="56" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s5" value="3. El sistema revisa el dato&lt;br&gt;(reglas simples, sin IA)" style="sketch=0;verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.lock2;fillColor=#fafafa;strokeColor=#005073;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="50" height="56" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s3" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="4. Estado del tanque y&lt;br&gt;pronóstico con rango (Chronos)" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/material-symbols/1/Network_Intelligence.svg;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="90" width="50" height="56" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s9" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="90" width="50" height="60" as="geometry"/></mxCell><mxCell id="txt10" value="5. Propuesta de turnos&lt;br&gt;explicada" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1040" y="156" width="200" height="40" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s7" target="s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s12" value="6. La Junta aprueba o&lt;br&gt;cambia con motivo" style="image;html=1;aspect=fixed;image=https://app.diagrams.net/img/lib/mscae/Person.svg;verticalLabelPosition=bottom;verticalAlign=top;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="330" width="50" height="56" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s9" target="s12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s14" value="7. Las familias se enteran&lt;br&gt;(página, WhatsApp, cartel)" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.whatsapp;fillColor=#00E676;strokeColor=#dddddd;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="330" width="50" height="56" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s12" target="s14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s16" value="8. Cierre del día:&lt;br&gt;qué pasó realmente" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.mobile;pointerEvents=1;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="330" width="50" height="56" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s14" target="s16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s18" value="9. Acta: observado, estimado,&lt;br&gt;inferido, confirmado" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.adobe_pdf;fillColor=#A60908;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="50" height="56" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s16" target="s18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s20" value="10. Equipo y entidades&lt;br&gt;(evaluación, resúmenes)" style="image;html=1;aspect=fixed;image=https://app.diagrams.net/img/lib/mscae/Person.svg;verticalLabelPosition=bottom;verticalAlign=top;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="330" width="50" height="56" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s18" target="s20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="txt22" value="Si la IA no responde se usa la estimación simple y todo sigue funcionando. Sin aprobación de la Junta no se publica nada. Las correcciones nunca borran el dato original." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1200" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
