<mxfile host="drawio"><diagram id="p0" name="flujo-caudal"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt1" value="Cómo funciona CAUDAL en 7 pasos (B2B)" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="s2" value="" style="image;html=1;aspect=fixed;image=https://app.diagrams.net/img/lib/mscae/Person.svg;verticalLabelPosition=bottom;verticalAlign=top;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="190" width="50" height="56" as="geometry"/></mxCell><mxCell id="txt3" value="1. CAUDAL da de alta la institución&lt;br&gt;(plantilla: tanque, líneas, válvulas)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="s4" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/iOS___Web_User_Interface_Multi_Circle_Flat_vol_5-2796/Cpu_microchip_sys_computer_electronic_processor-1313.svg;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="190" width="50" height="56" as="geometry"/></mxCell><mxCell id="txt5" value="2. El admin calibra el sensor&lt;br&gt;con la lectura en vivo (vacío / lleno)" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s7" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#dae8fc;strokeColor=#6c8ebf;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="190" width="50" height="56" as="geometry"/></mxCell><mxCell id="txt8" value="3. Tanque en vivo cada ~2 s:&lt;br&gt;distancia, nivel, %, litros" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s4" target="s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s10" value="" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=default;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/assets/material-symbols/1/Network_Intelligence.svg;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="190" width="50" height="56" as="geometry"/></mxCell><mxCell id="txt11" value="4. Pronóstico en tres salidas:&lt;br&gt;agua que queda, llega a la reserva en…,&lt;br&gt;banda Chronos; y eventos" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="240" height="70" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s7" target="s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s13" value="" style="sketch=0;verticalLabelPosition=bottom;html=1;verticalAlign=top;aspect=fixed;align=center;pointerEvents=1;shape=mxgraph.cisco19.lock2;fillColor=#fafafa;strokeColor=#005073;;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="400" width="50" height="56" as="geometry"/></mxCell><mxCell id="txt14" value="5. El piloto recomienda&lt;br&gt;(reglas sobre el pronóstico);&lt;br&gt;el asistente LLM responde preguntas" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="940" y="466" width="240" height="70" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s10" target="s13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s16" value="" style="verticalLabelPosition=bottom;align=center;html=1;verticalAlign=top;pointerEvents=1;dashed=0;shape=mxgraph.pid2valves.valve;valveType=ball;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="400" width="50" height="56" as="geometry"/></mxCell><mxCell id="txt17" value="6. Abrir o cerrar la válvula:&lt;br&gt;comando → puente USB → servo → ack" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="466" width="240" height="70" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s13" target="s16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s19" value="" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.adobe_pdf;fillColor=#A60908;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="400" width="50" height="56" as="geometry"/></mxCell><mxCell id="txt20" value="7. Cierre del día y acta:&lt;br&gt;observado, estimado,&lt;br&gt;inferido, confirmado" style="text;html=1;whiteSpace=wrap;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="466" width="240" height="70" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=classic;startArrow=none;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s16" target="s19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="txt22" value="Cada institución tiene sus datos aislados. La válvula siempre confirma (ack). Si la IA no responde se usa la estimación simple. El modelo de lenguaje no decide ni inventa cifras." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1200" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
